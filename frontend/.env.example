# ── AI Intelligence Engine ──────────────────────────────────
# Google Gemini — structured intelligence synthesis
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_URL=https://generativelanguage.googleapis.com

# ── Voice Synthesis ──────────────────────────────────────────
# Murf AI — professional female voice TTS
MURF_API_KEY=your-murf-api-key-here
MURF_API_URL=https://api.murf.ai/v1/speech/generate

# ── Firebase Authentication ──────────────────────────────────
# Get these from Firebase Console → Project Settings → Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain-here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id-here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket-here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id-here
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id-here


# ── Rate Limiting (Upstash Redis) ────────────────────────────
# Get these from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token-here

# ── Public Config ────────────────────────────────────────────
# Demo page YouTube video ID (optional)
NEXT_PUBLIC_DEMO_VIDEO_ID=

# Footer GitHub link (optional)
NEXT_PUBLIC_GITHUB_URL=https://github.com/sakshyambhttr-cyber
