rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    // Returns true if the request is from a signed-in user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns true if the requesting user owns the document (uid matches path)
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Validates that a string field exists and is within a length limit
    function validString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    // ── Users collection ────────────────────────────────────────────────────
    // /users/{uid}
    match /users/{uid} {
      // Only the authenticated owner can read their own profile
      allow read: if isOwner(uid);

      // Only the authenticated owner can create/update their own profile
      allow create, update: if isOwner(uid)
        && validString(request.resource.data.email, 256)
        && request.resource.data.keys().hasOnly([
             'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt', 'plan'
           ]);

      // Prevent deletion via client SDK
      allow delete: if false;

      // ── User sessions sub-collection ──────────────────────────────────────
      // /users/{uid}/sessions/{sessionId}
      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validString(request.resource.data.idea, 2000);
        allow update: if isOwner(uid);
        allow delete: if false;
      }

      // ── User ideas sub-collection ─────────────────────────────────────────
      // /users/{uid}/ideas/{ideaId}
      match /ideas/{ideaId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validString(request.resource.data.idea, 2000);
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }
    }

    // ── Public read-only collections ────────────────────────────────────────
    // e.g. feature metadata, pricing tiers — readable by anyone, writable by nobody
    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── Deny everything else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
